ADMIN_AUTH_HOST=127.0.0.1
ADMIN_AUTH_PORT=8790
ADMIN_AUTH_STATE_DIR=./data
ADMIN_AUTH_COOKIE_NAME=__Host-admin_session
ADMIN_AUTH_COOKIE_SECURE=true
ADMIN_AUTH_SESSION_TTL_SECONDS=2592000
ADMIN_AUTH_LOGIN_WINDOW_SECONDS=600
ADMIN_AUTH_LOGIN_MAX_ATTEMPTS=5

# These remain owned by /etc/invoice-submit.env.
INVOICE_ADMIN_USERNAME=admin
INVOICE_ADMIN_PASSWORD=replace-with-a-strong-password

# These remain owned by /etc/wechat-claw.env.
WECHATY_ADMIN_USERNAME=admin
WECHATY_ADMIN_PASSWORD=replace-with-a-strong-password
WECHATY_ADMIN_GUEST_USERNAME=guest
WECHATY_ADMIN_GUEST_PASSWORD=replace-with-a-different-strong-password
